# ─── เว็บแอปที่ทดสอบ ───
# (Cloudflare tunnel เปลี่ยนทุกครั้งที่ restart จึงเก็บไว้ที่นี่)
BASE_URL=http://localhost:5173

# ─── Backend API ───
# ใช้งานจริงเฉพาะตอน MOCK_API=false เท่านั้น
API_BASE_URL=http://localhost:5000

# ─── โหมดการทดสอบ (ตัวแปรหลัก!) ───
# true  = mock ทุก API call → ไม่มีข้อมูลเข้า database backend เลย
# false = ยิงเข้า backend จริง → ข้อมูลจะถูกบันทึกลง DB
MOCK_API=true

# ─── บัญชีทดสอบ (Login / Profile / Analysis) ───
# โหมด mock: เป็นแค่ค่าตัวแทน ไม่ถูกใช้จริง (mock ยอมรับอีเมลอะไรก็ได้)
# โหมดจริง (MOCK_API=false): ต้องเป็นบัญชีที่ "มีอยู่แล้ว" ในฐานข้อมูล
TEST_EMAIL=qa@example.test
TEST_PASSWORD=MockPassword123!

# ─── บัญชี QA สำหรับ registration flow ───
# โหมด mock: สมัครซ้ำใน test เดียวกันจะเจอ "อีเมลนี้ถูกใช้งานแล้ว" ตามที่ mock จำไว้
# โหมดจริง: ต้องเป็นอีเมลที่ "ยังไม่มี" ในระบบ แนะนำรูปแบบ +suffix เช่น qa-tester+reg2026@yourdomain.com
REGISTRATION_NAME=QA Tester
REGISTRATION_EMAIL=new-member@example.test
REGISTRATION_PASSWORD=MockPassword123!